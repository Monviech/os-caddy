{
    "version": "",
    "modules": [
{%  if OPNsense.xcaddy.general.modules -%}
{%      for module in OPNsense.xcaddy.general.modules.split(',') %}
        "{{ module }}"{% if not loop.last %},{% endif +%}
{%      endfor %}
{%  endif %}
    ],
    "module_overrides": [
{%  if OPNsense.xcaddy.general.module_overrides -%}
{%      for override in OPNsense.xcaddy.general.module_overrides.split(',') %}
        "{{ override }}"{% if not loop.last %},{% endif +%}
{%      endfor %}
{%  endif %}
    ]
}
